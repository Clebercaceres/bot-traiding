# Copia este archivo como .env y completa los valores

# URL de tu servidor desplegado
SERVER_URL=https://tu-dominio.com

# Tu cuenta en TradeBot (la que usas para hacer login en la web)
TB_EMAIL=tu@email.com
TB_PASSWORD=tu_contraseña

# ID de la cuenta MT5 (lo ves en el dashboard después de agregarla)
ACCOUNT_ID=1

# Credenciales MT5
MT5_LOGIN=123456
MT5_PASSWORD=tu_clave_mt5
MT5_SERVER=Deriv-Demo

# Ruta al terminal MT5 (ajusta si está en otra ubicación)
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

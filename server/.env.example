# Copia como .env en el servidor (nunca subir al repo)

# JWT — genera con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-en-produccion-minimo-32-caracteres

# Fernet para contraseñas MT5 — genera con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Si está vacía, contraseñas se guardan en claro (solo dev local)
FIELD_ENCRYPTION_KEY=

# Base de datos
# Local dev: SQLite
DATABASE_URL=sqlite:///./tradebot.db
# Producción (Railway/Render): PostgreSQL — Railway lo pone automático en DATABASE_URL
# DATABASE_URL=postgresql://user:password@host:5432/tradebot

PORT=8000
HOST=0.0.0.0

# MetaApi — para conectar cuentas Bridge sin agente Windows
# Obtén tu token en: https://app.metaapi.cloud/token
METAAPI_TOKEN=
